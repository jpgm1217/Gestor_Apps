{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "database.rules.json",
      ".firebaserc",
      "**/.*",
      ".git/**",
      "**/.git/**",
      ".firebase/**",
      "**/.firebase/**",
      "**/node_modules/**",
      "functions/**",
      "scripts/**",
      "tests/**",
      "test-results/**",
      "package.json",
      "package-lock.json",
      "**/*.md",
      "**/*.log",
      "*.zip"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "database": {
    "rules": "database.rules.json"
  }
}
